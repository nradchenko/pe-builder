;
; poweroff — power the machine off from the command shell, which a /minint PE has no
; service that can do.
;
; Adds a small poweroff.exe to system32 (on the PATH), compiled from the bundled
; poweroff.c at build time rather than shipped prebuilt.

[Version]
Signature = "$Windows NT$"

[PEBuilder]
Name = "poweroff"
Enable = 1

; The same source on either architecture; only the toolchain differs, so the shared [Build]
; holds the output and each [Build.<arch>] names that architecture's compiler.
[Build]
Produces = poweroff.exe

[Build.i386]
Requires = i686-w64-mingw32-gcc make
Command  = make ARCH=i386

[Build.amd64]
Requires = x86_64-w64-mingw32-gcc make
Command  = make ARCH=amd64

[SourceDisksFiles]
poweroff.exe = 2