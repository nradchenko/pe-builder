;
; terminal-services — bring up the WinStation/session subsystem, so the PE has a console session
; at all. Without one, nothing session-gated works: the theme server (visual styles), fast user
; switching, terminal services.
;
; Defines and starts the terminal-services stack (termdd + TermService/termsrv) and gives it the
; configuration its init demands. Not about remote desktop: no listener, connections denied.
; See README.md.
;
; Off by default. Enabling it auto-enables pesuite.

[Version]
Signature = "$Windows NT$"

[PEBuilder]
Name = "Terminal services (session subsystem)"

; The suite bit that makes winsrv run the WinStation init at all — without it the stack below
; starts and has nothing to serve.
[Update]
depends = pesuite

; termsrv.dll is the TermService implementation, loaded by svchost; its import closure (icaapi,
; mstlsapi, ...) comes with it. A closure cannot see everything this needs, though: the licensing
; init loads the RSA CSP by file name from the registry, and the base layer stages that.
; See README.md § What a closure cannot see.
[Closure]
termsrv.dll

; The terminal device driver; it ships inside SP3.CAB rather than loose.
[SourceDisksFiles]
termdd.sys = 4

[SetupReg.AddReg]
; termdd.sys: the terminal device driver (system-start), PortDriverEnable=1, no Group (as real).
0x4,"ControlSet001\Services\termdd","Type",0x1
0x4,"ControlSet001\Services\termdd","Start",0x1
0x4,"ControlSet001\Services\termdd","ErrorControl",0x1
0x2,"ControlSet001\Services\termdd","ImagePath","system32\DRIVERS\termdd.sys"
0x4,"ControlSet001\Services\termdd","PortDriverEnable",0x1
; The first key termsrv's init touches, and a fatal one: pre-creating it (empty, as a real XP has
; it) means the call opens rather than creates. See README.md § Why the config is close to the
; source's.
0x1,"ControlSet001\Control\Terminal Server\Licensing Core"
; TermService: hosted in the DcomLaunch svchost group (as real XP), depends on RPCSS, whitelisted.
0x4,"ControlSet001\Services\TermService","Type",0x20
0x4,"ControlSet001\Services\TermService","Start",0x2
0x4,"ControlSet001\Services\TermService","ErrorControl",0x1
; MUST be "svchost", NOT "svchost.exe": the SCM shares a host process by comparing ImagePath
; strings, so this has to match DcomLaunch's own value apart from case — as a real XP has it.
; See README.md § The `svchost` ImagePath trap.
0x2,"ControlSet001\Services\TermService","ImagePath","%SystemRoot%\System32\svchost -k DComLaunch"
0x1,"ControlSet001\Services\TermService","ObjectName","LocalSystem"
0x7,"ControlSet001\Services\TermService","DependOnService","RPCSS"
0x2,"ControlSet001\Services\TermService\Parameters","ServiceDll","%SystemRoot%\System32\termsrv.dll"
0x1,"Setup\AllowStart\TermService"
; Terminal Server config: the top-level values, the WinStations security descriptors, the Console
; WinStation, and DefaultUserConfiguration — reproduced from an installed XP SP3, and deliberately
; close to it. Console\WdDll names wdcon.dll, which is NOT staged (not on the install media), and
; that is fine. Trim only a value at a time against a real boot.
; See README.md § Why the config is close to the source's and § What is deliberately absent.
0x4,"ControlSet001\Control\Terminal Server","fAllowToGetHelp",0x1
0x4,"ControlSet001\Control\Terminal Server","FirstCountMsgQPeeksSleepBadApp",0xf
0x7,"ControlSet001\Control\Terminal Server","Modems With Bad DSR","MultiTech MultiModem MT2834","MultiTech MultiModem MT2834ZDX","MultiTech MT2834","MultiTech MT2834ZDX","MultiTech 2834","MultiTech 2834ZDX"
0x4,"ControlSet001\Control\Terminal Server","MsgQBadAppSleepTimeInMillisec",0x1
0x4,"ControlSet001\Control\Terminal Server","NthCountMsgQPeeksSleepBadApp",0x5
0x4,"ControlSet001\Control\Terminal Server","fWritableTSCCPermTab",0x0
0x4,"ControlSet001\Control\Terminal Server","DeleteTempDirsOnExit",0x0
0x4,"ControlSet001\Control\Terminal Server","PerSessionTempDir",0x0
0x4,"ControlSet001\Control\Terminal Server","fDenyTSConnections",0x1
0x1,"ControlSet001\Control\Terminal Server","ProductVersion","5.1"
0x4,"ControlSet001\Control\Terminal Server","TSAdvertise",0x0
0x4,"ControlSet001\Control\Terminal Server","IdleWinStationPoolCount",0x0
