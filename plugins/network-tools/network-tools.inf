;
; network-tools — the command-line network utilities, for a PE that has a network.
; Enabling this pulls in `hardware`, which is what configures the network at boot.

[Version]
Signature = "$Windows NT$"

[PEBuilder]
Name = "Network tools"

[Update]
depends = hardware

[Closure]
ipconfig.exe
ping.exe
route.exe
arp.exe
tracert.exe
nslookup.exe
hostname.exe

; arp reads the ARP table through SNMP's MIB-II provider and loads it by name at run time,
; so no import closure can see these. See README.md § The two hand-seeded DLLs.
mgmtapi.dll
inetmib1.dll
