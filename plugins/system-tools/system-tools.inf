;
; system-tools — GUI system-administration tools for the PE.
; Off by default; auto-enabled by dependents or enabled directly.
;
; Each tool is a [Closure] seed, so whatever it imports is staged with it, and contributes one
; Start-menu entry through the shell's registry contract. Nothing here is arch-specific.

[Version]
Signature = "$Windows NT$"

[PEBuilder]
Name = "System tools"

[Update]
depends = win32-gui

[Closure]
regedit.exe
taskmgr.exe

[SourceDisksFiles]
; Task Manager resolves the User Name column through utildll.dll, loaded by name.
utildll.dll = 2

[Software.AddReg]
0x2,"pe-builder\StartMenu","Registry Editor","%SystemRoot%\regedit.exe"
0x2,"pe-builder\StartMenu","Task Manager","%SystemRoot%\system32\taskmgr.exe"
