/* Copyright 2026 Nikita Radchenko
 * SPDX-License-Identifier: Apache-2.0
 *
 * The Windows VERSIONINFO resource every binary a plugin builds carries, so each one
 * identifies itself in Properties -> Details and in Task Manager.
 *
 * This file is shared, not per-plugin: the build materializes it into every plugin's
 * build directory as `pebuild/version.rc` (see plugin/build.go). It holds no values of
 * its own — the Makefile supplies all of them as windres -D defines, which is what lets
 * one template serve an EXE, a DLL and a driver. Defaults cover only what a caller may
 * legitimately leave unset; the rest must be given, so a missing one is a build error
 * rather than a binary that ships blank.
 */

#include <winver.h>

#ifndef VER_FILETYPE
#define VER_FILETYPE VFT_APP
#endif
#ifndef VER_FILESUBTYPE
#define VER_FILESUBTYPE VFT2_UNKNOWN
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_NUM
PRODUCTVERSION  VER_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VER_FILETYPE
FILESUBTYPE     VER_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 040904B0 — US English, Unicode. */
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      VER_COMPANY
            VALUE "ProductName",      VER_PRODUCT
            VALUE "ProductVersion",   VER_STR
            VALUE "FileVersion",      VER_STR
            VALUE "FileDescription",  VER_DESC
            VALUE "InternalName",     VER_INTERNAL
            VALUE "OriginalFilename", VER_ORIGINAL
            VALUE "LegalCopyright",   VER_COPYRIGHT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END