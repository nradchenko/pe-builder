;
; accessories — small GUI accessory apps for the PE.
; Off by default; auto-enabled by dependents or enabled directly.
;
; Each app is a [Closure] seed, so whatever it imports is staged with it, and contributes one
; Start-menu entry through the shell's registry contract. Nothing here is arch-specific.

[Version]
Signature = "$Windows NT$"

[PEBuilder]
Name = "Accessories"
Enable = 0

[Update]
depends = win32-gui

[Closure]
clipbrd.exe
mspaint.exe

[Software.AddReg]
0x2,"pe-builder\StartMenu","Clipboard Viewer","%SystemRoot%\system32\clipbrd.exe"
0x2,"pe-builder\StartMenu","Paint","%SystemRoot%\system32\mspaint.exe"
