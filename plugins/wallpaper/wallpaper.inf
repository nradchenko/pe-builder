;
; wallpaper — a desktop wallpaper for the Explorer desktop, which otherwise renders on a flat
; background colour.
;
; Stages and configures only: it ships no code and needs no toolchain. Explorer reads the values
; written below when the shell starts. See README.md.
;
; Off by default. Enabling it auto-enables the desktop it decorates.

[Version]
Signature = "$Windows NT$"

[PEBuilder]
Name = "Desktop wallpaper"

; explorer-shell = the desktop this decorates, and the process that reads these values.
[Update]
depends = explorer-shell

; The XP default wallpaper, re-encoded as a bitmap on the way in (attribute 64).
;
; The classic desktop paints bitmaps and nothing else, and 64-bit Windows has no Active Desktop
; to paint anything else with — the feature is absent from XP x64, not merely disabled. So the
; source's JPEG becomes a BMP here, which is exactly what Windows does when a user picks a
; non-BMP wallpaper. Doing it at build time means nothing in the image needs a decoder, and one
; path serves both architectures. See README.md § Why a bitmap.
;
; The media stores it compressed under an 8.3 name (BLISS.JP_), which the engine resolves from
; the bare name; field 1 renames the staged file, and dir ID 2 is system32, the flat directory a
; PE runs from. See README.md § Why system32 and not Web\Wallpaper.
[SourceDisksFiles]
bliss.jpg = 2,bliss.bmp,64

; --- Wallpaper selection for the (default) user the PE runs as (DEFAULT hive) ---
; DEFAULT because the PE runs as SYSTEM with no profile loaded, so HKCU is HKU\.DEFAULT.
;
; Wallpaper must stay REG_EXPAND_SZ (0x2) — the PE's system drive is X:, not C:, so an absolute
; path baked at build time would be wrong at run time. WallpaperStyle and TileWallpaper are
; REG_SZ even though they hold digits: XP writes and reads them as strings.
;
; Style 2 = stretch, with tiling off: the image is scaled to whatever resolution the manifest
; selects rather than leaving a border. See README.md § Fit.
[Default.AddReg]
0x2,"Control Panel\Desktop","Wallpaper","%SystemRoot%\System32\bliss.bmp"
0x1,"Control Panel\Desktop","WallpaperStyle","2"
0x1,"Control Panel\Desktop","TileWallpaper","0"