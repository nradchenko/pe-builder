# --- local / private working files (never committed, not for public release) ---

# Third-party freeware binaries used for reference (do not distribute)
.cache/

# Local Windows test sources: real media the developer supplies for the real-source
# tests, as files or as symlinks. The directory itself is kept in the tree — its README
# says what to put there — so everything inside is ignored except that README. Ignoring
# the directory instead would take the README with it, since git cannot re-include a
# file whose directory is excluded.
/testdata/iso/*
!/testdata/iso/README.md

# Local, developer-specific instructions
CLAUDE.local.md

# IDE / editor project files
.idea/

# Internal working documents
docs/internal/

# --- build / output artifacts ---
/bin/
/dist/
/out/
/pebuild
*.iso
*.img